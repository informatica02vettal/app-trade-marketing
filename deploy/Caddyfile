# Caddy hace de único punto de entrada HTTPS en producción, usando el
# certificado real emitido por IT (.crt + .key) — ni el backend (Spring
# Boot/NSSM, puerto 8081) ni el frontend (serve/NSSM, puerto 4200) necesitan
# cambiar: siguen corriendo exactamente igual, solo dejan de estar expuestos
# directo a internet.
#
# Ajusta las dos rutas de abajo a donde copies el certificado y la clave
# reales que te dio IT.
vettal.ddns.net {
	tls "C:/certs/vettal.ddns.net.crt" "C:/certs/vettal.ddns.net.key"

	# Todo lo que el backend expone vive bajo /api/v1 (ver SecurityConfig y
	# los @RequestMapping de los controllers) — se enruta al backend.
	handle /api/* {
		reverse_proxy localhost:8081
	}

	# El resto (la SPA de Angular) va al servidor estático "serve".
	handle {
		reverse_proxy localhost:4200
	}
}
