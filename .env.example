# ============================================================
# app-trade-marketing — variables de entorno
# Copia este archivo como ".env" y completa con las credenciales
# reales. NUNCA subas el archivo ".env" al repositorio.
# ============================================================

# --- Perfil activo (dev | prod) ---
SPRING_PROFILES_ACTIVE=dev

# --- Puerto del servidor ---
SERVER_PORT=8081

# --- Base de datos PROPIA de app-trade-marketing ---
# Nueva, independiente del ERP. Flyway crea/migra el esquema
# automáticamente al iniciar la aplicación (no requiere scripts manuales).
DB_TRADE_URL=jdbc:mariadb://localhost:3306/app_trade_marketing?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_TRADE_USER=CAMBIA_ESTE_USUARIO
DB_TRADE_PASSWORD=CAMBIA_ESTA_CLAVE

# --- API de clientes (vettal-backend, endpoint GET /api/v1/clientes/search) ---
# Esta app NO se conecta directo a la base de datos del ERP: consume el endpoint
# REST que ya expone vettal-backend, autenticado con HTTP Basic Auth. El usuario
# configurado aquí debe existir en vettal-backend con rol SISTEMAS o ADMINISTRACION.
CLIENTES_API_BASE_URL=https://CAMBIA_ESTA_URL_DE_VETTAL_BACKEND_EN_PRODUCCION
CLIENTES_API_USER=CAMBIA_ESTE_USUARIO
CLIENTES_API_PASSWORD=CAMBIA_ESTA_CLAVE

# --- API de productos (ERP, tabla lista_prod_pw) ---
# Autenticada con un apikey por query param (no HTTP Basic Auth).
PRODUCTOS_API_BASE_URL=https://CAMBIA_ESTA_URL_DEL_ERP/api/v1.php
PRODUCTOS_API_KEY=CAMBIA_ESTE_APIKEY
PRODUCTOS_API_TABLA=lista_prod_pw

# --- Autenticación JWT ---
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ALLOWED_ORIGINS=*

# --- Usuario ADMIN inicial ---
# Se crea automáticamente al arrancar la app si todavía no existe ningún
# usuario con este email (equivalente al script "seed:admin" del backend Node).
ADMIN_EMAIL=admin@vettal.com.ve
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_TEMPORAL
ADMIN_NOMBRE=Administrador

# --- Almacenamiento de evidencia fotográfica ---
# Carpeta donde se guardan las fotos/videos subidos vía POST /api/v1/archivos.
# Quedan ahí de forma permanente en el servidor (no dependen de que la app
# del mercaderista siga abierta) y se sirven de vuelta como estáticos bajo
# /files/**.
STORAGE_BASE_PATH=./media
